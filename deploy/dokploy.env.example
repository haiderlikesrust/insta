# Paste into Dokploy Environment. Never commit filled-in values.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
# Public URL and your wallet address (never your dev wallet's private key).
APP_ORIGIN=https://instara.xyz
DEV_WALLET_ADDRESS=
# Mainnet RPC provider URL and Apify API token.
SOLANA_RPC_URL=
APIFY_API_TOKEN=
# Dedicated backend wallet: base58 private key or JSON array of 64 bytes.
# Fund with SOL for claims, rent and network fees. Back up securely; do not rotate it casually.
BACKEND_WALLET_SECRET_KEY=
# Enable only after testing the deployment with real integrations.
MAIN_LAUNCH_ENABLED=false
LIVE_LAUNCHES_ENABLED=false
# Meteora config, main mint and lookup table are saved by /admin; no manual keys needed.
