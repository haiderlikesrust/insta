# Paste into Dokploy Environment. Do not commit filled-in values.
APP_ORIGIN=https://instara.xyz
# Generate a 64-character hex password. Keep it stable across redeployments.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
APIFY_API_TOKEN=
SOLANA_RPC_URL=
METEORA_CONFIG_KEY=
ESCROW_PROGRAM_ID=
VERIFIER_PUBLIC_KEY=
VERIFIER_SECRET_KEY=
LIVE_LAUNCHES_ENABLED=false
ESCROW_REVIEWED=false

# Signed-wallet access to /admin (public wallet address, never a secret key).
DEV_WALLET_ADDRESS=
# Enables the direct-to-dev main token launch independently of community launches.
MAIN_LAUNCH_ENABLED=false
# Main SPL token mint and optional existing Meteora INSTARA/SOL pool.
INSTARA_MINT=
INSTARA_BUYBACK_POOL=
BUYBACK_SLIPPAGE_BPS=100
# Comma-separated address lookup tables prepared for atomic claims.
SOLANA_LOOKUP_TABLES=
